{
  "name": "qts-public-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QTS public website and internal portal API",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:rollback": "tsx scripts/migrate.ts down",
    "db:seed": "tsx scripts/seed.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js up",
    "db:seed:prod": "node dist/scripts/seed.js",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "db:bootstrap-admin:prod": "node dist/scripts/bootstrap-admin.js",
    "contract-template:provision": "tsx scripts/provision-contract-template.ts",
    "contract-template:provision:prod": "node dist/scripts/provision-contract-template.js",
    "archive:ingest": "tsx scripts/ingest-stored-archive.ts",
    "archive:ingest:prod": "node dist/scripts/ingest-stored-archive.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "docxtemplater": "^3.69.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "libphonenumber-js": "^1.13.10",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pizzip": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
