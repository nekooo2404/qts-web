NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://qts_app:qts_local_development_only@localhost:5434/qts_public
DATABASE_SSL=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000

CORS_ORIGINS=http://localhost:3000
# Number of trusted reverse-proxy hops. Keep 0 when Express is internet-facing.
TRUST_PROXY_HOPS=0

# Generate a unique random secret of at least 32 bytes per environment.
JWT_SECRET=CHANGE_ME
JWT_ISSUER=qts-internal-api
JWT_AUDIENCE=qts-internal-portal
JWT_EXPIRES_IN_SECONDS=900
# Separate secret for pseudonymizing client IPs in security audit metadata.
AUDIT_IP_HASH_SECRET=CHANGE_ME_SEPARATELY

# Supply these only to the one-time bootstrap command, then remove them.
# BOOTSTRAP_ADMIN_EMAIL=admin@qts.vn
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-strong-password
# BOOTSTRAP_ADMIN_FULL_NAME=QTS Administrator
# BOOTSTRAP_ADMIN_EMPLOYEE_CODE=QTS-ADMIN-001

INTERNAL_FILE_STORAGE_ROOT=./storage
MAX_ARCHIVE_BYTES=1073741824
# Per API process. Keep byte budget at least MAX_ARCHIVE_BYTES.
MAX_ARCHIVE_INFLIGHT_DOWNLOADS=2
MAX_ARCHIVE_INFLIGHT_BYTES=2147483648
ARCHIVE_DOWNLOAD_RETRY_AFTER_SECONDS=5
MAX_DOCX_TEMPLATE_BYTES=5242880
MAX_DOCX_UNCOMPRESSED_BYTES=20971520
MAX_DOCX_OUTPUT_BYTES=10485760
MAX_DOCX_TEMPLATE_ENTRIES=512
# Per API process. Budget must admit 2 * (template + expanded + output).
MAX_DOCX_INFLIGHT_GENERATIONS=1
MAX_DOCX_INFLIGHT_BYTES=73400320
DOCX_GENERATION_TIMEOUT_MS=10000
DOCX_WORKER_MAX_OLD_GENERATION_SIZE_MB=96
DOCX_GENERATION_RETRY_AFTER_SECONDS=5

# Mandatory malware scanner for the trusted archive-ingestion CLI. Exit 0 means
# clean, exit 1 means infected, and every other exit/timeout is a scanner error.
# The CLI appends the copied archive path as the final argument without a shell.
ARCHIVE_SCANNER_EXECUTABLE=C:\Program Files\ClamAV\clamscan.exe
ARCHIVE_SCANNER_ARGS_JSON=["--no-summary"]
ARCHIVE_SCANNER_TIMEOUT_MS=120000
ARCHIVE_SCANNER_MAX_OUTPUT_BYTES=65536

# One-time values for `npm run archive:ingest`. Prefer explicit CLI flags.
# ARCHIVE_INGEST_SOURCE_PATH=D:\secure-input\customer-record.zip
# ARCHIVE_INGEST_ORIGINAL_FILENAME=customer-record.zip
# ARCHIVE_INGEST_ACTOR_ID=00000000-0000-4000-8000-000000000000
# Set exactly one context: owner, contract, or task.
# ARCHIVE_INGEST_OWNER_ID=00000000-0000-4000-8000-000000000000
# ARCHIVE_INGEST_CONTRACT_ID=00000000-0000-4000-8000-000000000000
# ARCHIVE_INGEST_TASK_ID=00000000-0000-4000-8000-000000000000

# One-time values for `npm run contract-template:provision`.
# CONTRACT_TEMPLATE_SOURCE_PATH=D:\secure-input\qts-contract.docx
# CONTRACT_TEMPLATE_NAME=QTS service agreement
# CONTRACT_TEMPLATE_DESCRIPTION=Approved service contract template
# CONTRACT_TEMPLATE_ALLOWED_FIELDS=contractNumber,customerName,items
# CONTRACT_TEMPLATE_OUTPUT_FILENAME=QTS-contract.docx
# CONTRACT_TEMPLATE_ACTOR_ID=00000000-0000-4000-8000-000000000000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=QTS Website <no-reply@example.com>
SMTP_TO=sales@example.com
PUBLIC_BASE_URL=http://localhost:3000
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_MS=120000
OUTBOX_POLL_INTERVAL_MS=5000
