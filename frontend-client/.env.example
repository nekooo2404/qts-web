# Server-side origin used for public content rendering.
BACKEND_API_URL=http://localhost:4000
# Production defaults to fail-closed for projects, solutions, and capabilities.
# Company contact information is the only operational fallback and is visibly disclosed.
# Use fixture only for preview/test environments.
CMS_FALLBACK_MODE=error
# GET retry attempts; bounded to 1-3. Contact POST is never retried.
CMS_FETCH_ATTEMPTS=2
# Canonical public origin used by metadata, sitemap, and robots.
SITE_URL=https://qts.com.vn
# Immutable release or commit identifier exposed to Web Vitals telemetry.
NEXT_PUBLIC_APP_RELEASE=development
# Enable both only when the deployment log/telemetry pipeline is ready.
NEXT_PUBLIC_TELEMETRY_ENABLED=false
TELEMETRY_INGEST_ENABLED=false
# Maximum retention period disclosed by the contact privacy notice.
CONTACT_RETENTION_DAYS=180
